      "visual_findings": [],
      "entry": "q_responsive_g",
      "nodes": {
        "q_responsive_g": {
          "type": "question",
          "prompt": "I'm here to help. First: is the person awake and responding?",
          "yes": "q_breathing_g",
          "no": "to_unresponsive_g",
          "unsure": "to_unresponsive_g"
        },
        "to_unresponsive_g": {
          "type": "escalate",
          "protocol": "unresponsive_breathing",
          "text": "Not responding comes first."
        },
        "q_breathing_g": {
          "type": "question",
          "prompt": "Are they having any trouble breathing?",
          "yes": "to_breathing_g",
          "no": "q_bleeding_g",
          "unsure": "q_bleeding_g"
        },
        "to_breathing_g": {
          "type": "escalate",
          "protocol": "breathing_difficulty",
          "text": "Breathing comes first."
        },
        "q_bleeding_g": {
          "type": "question",
          "prompt": "Is there heavy bleeding?",
          "yes": "to_bleeding_g",
          "no": "describe_g",
          "unsure": "describe_g"
        },
        "to_bleeding_g": {
          "type": "escalate",
          "protocol": "severe_bleeding",
          "text": "We control the bleeding now."
        },
        "describe_g": {
          "type": "handoff",
          "text": "Okay. Tell me in a few words what happened or what hurts — for example: burned hand, chest pain, bad fall, swallowed something."
        }
      }
    },
