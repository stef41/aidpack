      "entry": "q_choke_bd",
      "nodes": {
        "q_choke_bd": {
          "type": "question",
          "prompt": "Were they eating or putting something in their mouth — could something be stuck in their throat?",
          "yes": "to_choking_bd",
          "no": "q_allergy_bd",
          "unsure": "q_allergy_bd"
        },
        "to_choking_bd": {
          "type": "escalate",
          "protocol": "choking",
          "text": "We treat this as choking."
        },
        "q_allergy_bd": {
          "type": "question",
          "prompt": "Could this be an allergic reaction — swelling lips or tongue, hives, or a known serious allergy?",
          "yes": "to_ana_bd",
          "no": "q_asthma_bd",
          "unsure": "q_asthma_bd"
        },
        "to_ana_bd": {
          "type": "escalate",
          "protocol": "anaphylaxis",
          "text": "We treat this as a severe allergic reaction."
        },
        "q_asthma_bd": {
          "type": "question",
          "prompt": "Do they have asthma?",
          "yes": "to_asthma_bd",
          "no": "sit_upright_bd",
          "unsure": "sit_upright_bd"
        },
        "to_asthma_bd": {
          "type": "escalate",
          "protocol": "asthma_attack",
          "text": "We follow the asthma steps."
        },
        "sit_upright_bd": {
          "type": "step",
          "text": "Help them into the position where breathing feels easiest — usually sitting upright, leaning slightly forward. Loosen tight clothing. Open a window for fresh air.",
          "donot": [
            "Do not lie them flat while they struggle to breathe.",
            "Do not give food or drink.",
            "Do not leave them alone."
          ],
          "next": "calm_bd"
        },
        "calm_bd": {
          "type": "step",
          "text": "Stay calm with them and encourage slow, steady breaths. If they have any prescribed inhaler or oxygen, help them use it.",
          "next": "monitor_bd"
        },
        "monitor_bd": {
          "type": "monitor",
          "text": "Watch them constantly until help arrives. Tell me immediately if lips turn blue or gray, they can only speak single words, or they become drowsy or stop responding."
        }
      }
    }
